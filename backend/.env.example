# ============================================================
# Railway / Production Environment Variables Template
# Copy these into Railway's "Variables" panel (never commit real values)
# ============================================================

# Django
DEBUG=False
SECRET_KEY=REPLACE_WITH_A_STRONG_RANDOM_KEY
ALLOWED_HOSTS=your-app.up.railway.app

# Postgres — Railway auto-provides this when you add the Postgres plugin
DATABASE_URL=${{Postgres.DATABASE_URL}}

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Groq AI
GROQ_API_KEY=your_groq_api_key

# CORS — set to your Vercel frontend URL (no trailing slash)
CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app
