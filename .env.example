# ============================================================
# PortfolioBuilder Global Environment Variables Reference
# ============================================================
# This file serves as a guide for configuring both services.
# Copy appropriate variables to backend/.env and frontend/.env.

# ------------------------------------------------------------
# 🐍 BACKEND ENVIRONMENT VARIABLES (backend/.env)
# ------------------------------------------------------------

# Set to True for development, False in production
DEBUG=True

# Generate a strong secret key for production (e.g. using `openssl rand -hex 32`)
SECRET_KEY=replace_with_a_secure_random_key_here

# Hosts allowed to access backend (comma-separated for dev, single domain for prod)
ALLOWED_HOSTS=localhost,127.0.0.1

# Database connection URL (Django defaults to sqlite3 if not set)
# Production e.g.: postgres://user:password@host:port/dbname
DATABASE_URL=sqlite:///db.sqlite3

# Groq API key (Required for AI resume parsing & chat assistance)
# Get yours here: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# Cloudinary Integration (Required for uploading avatars/project photos)
# Get credentials at: https://cloudinary.com/
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# CORS Allowed Origins (Must match your frontend URL, no trailing slash)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Redis connection URL (Optional, required in production for Django Channels WebSocket layers)
# Local dev defaults to InMemoryChannelLayer if not set
REDIS_URL=redis://127.0.0.1:6379

# ------------------------------------------------------------
# ⚛️ FRONTEND ENVIRONMENT VARIABLES (frontend/.env)
# ------------------------------------------------------------

# Base URL to access the Django API endpoints
VITE_API_URL=http://localhost:8000/api
# Base URL for WebSocket connections (Optional, auto-derives from VITE_API_URL if omitted)
VITE_WS_URL=ws://localhost:8000
